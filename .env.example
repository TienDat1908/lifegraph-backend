# Rails reads these values from the process environment. Do not commit a real .env file.
LIFEGRAPH_DATABASE_HOST=localhost
LIFEGRAPH_DATABASE_PORT=5432
LIFEGRAPH_DATABASE_USERNAME=postgres
LIFEGRAPH_DATABASE_PASSWORD=postgres

# Production should normally provide a managed DATABASE_URL instead.
# DATABASE_URL=postgresql://user:password@host:5432/lifegraph_backend_production
